{
  "id": "mcp-2lo",
  "realm": "mcp-2lo",
  "displayName": "MCP 2-legged OAuth",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 14400,
  "clients": [
    {
      "clientId": "adk",
      "name": "ADK agent",
      "description": "2-legged OAuth caller for the main ADK agent",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "adk-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "exchange-rate:read",
        "quickchart:write"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "aud-custom-mcp-exchange-rate",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "custom-mcp-exchange-rate",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-custom-mcp-quickchart",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "custom-mcp-quickchart",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "custom-mcp-exchange-rate",
      "name": "Custom MCP Exchange Rate",
      "description": "Resource server / audience for the exchange-rate MCP server",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false
    },
    {
      "clientId": "custom-mcp-quickchart",
      "name": "Custom MCP QuickChart",
      "description": "Resource server / audience for the QuickChart MCP server",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false
    }
  ],
  "clientScopes": [
    {
      "name": "exchange-rate:read",
      "description": "Call the exchange-rate MCP server",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "quickchart:write",
      "description": "Call the QuickChart MCP server",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ]
}
